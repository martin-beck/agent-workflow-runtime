{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-runtime/blob/main/protocols/agent-session-v1.schema.json",
  "title": "Agent Workflow Runtime session event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "task_id", "task_revision", "session_id", "adapter", "disposition", "evidence_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^EV-[A-Z0-9-]{1,63}$"},
    "event_type": {"type": "string", "enum": ["session_started", "plan_proposed", "specification_proposed", "oracle_required", "oracle_answered", "tool_call", "file_change", "test_result", "formal_result", "quality_result", "commit_created", "pull_request", "ci_update", "checkpointed", "interrupted", "failed", "completed"]},
    "task_id": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
    "task_revision": {"type": "integer", "minimum": 1},
    "session_id": {"type": "string", "pattern": "^SES-[A-Z0-9-]{1,63}$"},
    "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}@[^ ]{1,32}$"},
    "disposition": {"type": "string", "enum": ["started", "accepted", "rejected", "blocked", "passed", "failed", "cancelled", "completed"]},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

